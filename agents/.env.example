# ── Provider modes ────────────────────────────────────────────────────────
# mock (default): everything runs locally with fakes. live: real integrations.
WORLD_MODE=mock
ZEROG_MODE=mock

# ── Mock demo knobs (only read in mock mode) ─────────────────────────────
# Force the IDKit claim to fail: user_rejected | cancelled | timeout |
# credential_unavailable | nullifier_replayed | error
#WORLD_FAIL_WITH=user_rejected
# Force the payout-approval decision (mocked checkpoint): approved | denied | expired
#WORLD_APPROVAL=denied
# Simulate a 0G outage (demos the safe-stop path)
#ZEROG_UNREACHABLE=1

# ── World live config (WORLD_MODE=live) ──────────────────────────────────
# World ID 4.0 via IDKit (@worldcoin/idkit-core 4.6.0). App from https://developer.world.org
WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...
# RP signing key: 32 bytes hex (64 chars), shown once at World ID 4.0 registration. SERVER ONLY.
WORLD_RP_SIGNING_KEY=
# production = real World App (only signs production proofs); staging = simulator.worldcoin.org only
WORLD_ENV=production
# Developer Portal team API key (api_…): creates one World ID action per bounty via the portal MCP
# (create_world_id_action). Portal → your team → API keys. SERVER ONLY.
WORLD_PORTAL_API_KEY=
# Local page that shows the claim QR (smoke:world)
#WORLD_QR_PORT=8799

# ── 0G Chain wallets (written by `npx tsx agents/scripts/new-wallet.ts <ROLE>`) ──
# Deployer: deploys contracts on Galileo (chain 16602). Never paste keys in chat.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Robot agents: AGENT_G1 operates robot G1 (sim), AGENT_2 operates robot R2.
# Create with new-wallet.ts AGENT_G1 / AGENT_2 (refuses to overwrite). List with `npm run wallets`.
AGENT_G1_PRIVATE_KEY=
AGENT_G1_ADDRESS=
AGENT_2_PRIVATE_KEY=
AGENT_2_ADDRESS=

# ── Physical bounty devices (agents service: npm run serve) ──────────────
# MQTT broker the Watcher firmware connects to (Mumbai EMQX creds work here;
# topic prefix stays monaid/ to match the broker's device ACLs)
BROKER_URL=mqtts://<broker-host>:8883
BROKER_USER=bridge
BROKER_PASS=
# Relay room where claim.html posts claims, and the base URL baked into the QR
CLAIMS_WS_URL=wss://pickle-hand-relay.pickle-delhi.workers.dev/claims
CLAIM_BASE_URL=https://pickle-hand-relay.pickle-delhi.workers.dev

# ── Teleop bounties (MuJoCo G1 sim) ──────────────────────────────────────
# The sim must run with AGENTS_WEBHOOK_URL=http://localhost:8090/events/sim
SIM_URL=http://localhost:8787
SIM_TELEOP_TOKEN=dev-token
AGENTS_PORT=8090

# ── 0G live config (ZEROG_MODE=live) ─────────────────────────────────────
# Text decisions: router = 0G Private Computer Router, mainnet, sk- key (CURRENT, $ credits)
#                 direct = Galileo testnet via broker SDK (shelved: provider needs a 1 0G sub-account reserve)
# Vision always uses the Router.
ZEROG_COMPUTE_MODE=router
# Direct mode pays from its own wallet, never the deployer.
# Create: npx tsx agents/scripts/new-wallet.ts COMPUTE_WALLET · status/fund: npx tsx zerog/scripts/fund-testnet-compute.ts
COMPUTE_WALLET_PRIVATE_KEY=
COMPUTE_WALLET_ADDRESS=
# Optional: override provider (default 0xd6269e…C940 = qwen/qwen3.8-omni-flash, the only reachable testnet chatbot)
#ZEROG_PROVIDER_ADDRESS=
# Optional: override the provider's model id; 1 = reject responses whose TEE signature fails
#ZEROG_DIRECT_MODEL=
#ZEROG_DIRECT_REQUIRE_TEE=1
# Mainnet Router (decision D3). Testnet router-api-testnet.integratenetwork.work was unreachable 2026-11-06.
ZEROG_ROUTER_URL=https://router-api.0g.ai/v1
# Router keys (pc.0g.ai → API Keys). Trust mode is set per key in the dashboard.
# ZEROG_ROUTER_KEY = Private/TEE trust mode (responses carry x-0g-e2ee: sealed)
ZEROG_ROUTER_KEY=sk-...
# Optional Standard-trust key: used for ONE call only when a model isn't served in TEE mode
ZEROG_ROUTER_KEY_STANDARD=
# TEE-attested, text + image (live catalog: GET https://router-api.0g.ai/v1/models).
# A reasoning model: the client sends chat_template_kwargs.enable_thinking=false (otherwise content is empty)
ZEROG_MODEL=0gm-1.0-35b-a3b
# Vision model (default = ZEROG_MODEL)
#ZEROG_VISION_MODEL=0gm-1.0-35b-a3b
# Ask the Router to verify the provider TEE signature (verify_tee). 1 = on
ZEROG_VERIFY_TEE=1
# Optional mk- management key: lets smoke:compute print the account balance
ZEROG_MANAGEMENT_KEY=
# Galileo RPC (direct compute + storage). ZEROG_PRIVATE_KEY = storage uploads only.
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_PRIVATE_KEY=
ZEROG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
