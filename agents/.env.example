# ── Provider modes ────────────────────────────────────────────────────────
# mock (default): everything runs locally with fakes. live: real integrations.
WORLD_MODE=mock
ZEROG_MODE=mock

# ── Mock demo knobs (only read in mock mode) ─────────────────────────────
# Force the IDKit claim to fail: user_rejected | cancelled | timeout |
# credential_unavailable | nullifier_replayed | error
#WORLD_FAIL_WITH=user_rejected
# Force the Agent Pass decision: approved | denied | expired
#WORLD_APPROVAL=denied
# Simulate a 0G outage (demos the safe-stop path)
#ZEROG_UNREACHABLE=1

# ── World live config (WORLD_MODE=live) ──────────────────────────────────
# IDKit app from https://developer.world.org
WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...
WORLD_RP_SIGNING_KEY=
# staging (simulator.worldcoin.org) or production
WORLD_ENV=staging
# Agent Pass / World IdP client from https://auth.world.org/portal
WORLD_IDP_CLIENT_ID=
WORLD_IDP_CLIENT_SECRET=worldidp_client_secret_...
WORLD_IDP_ISSUER=https://auth.world.org

# ── 0G Chain wallets (written by `npx tsx agents/scripts/new-wallet.ts <ROLE>`) ──
# Deployer: deploys contracts on Galileo (chain 16602). Never paste keys in chat.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Robot agents: AGENT_G1 operates robot G1 (sim), AGENT_2 operates robot R2.
# Create with new-wallet.ts AGENT_G1 / AGENT_2 (refuses to overwrite). List with `npm run wallets`.
AGENT_G1_PRIVATE_KEY=
AGENT_G1_ADDRESS=
AGENT_2_PRIVATE_KEY=
AGENT_2_ADDRESS=

# ── 0G live config (ZEROG_MODE=live) ─────────────────────────────────────
# Text decisions: direct = Galileo testnet via broker SDK (wallet-paid, default)
#                 router = mainnet Router (sk- key). Vision always uses the Router
#                 (testnet has no image-capable model as of 2026-11-06).
ZEROG_COMPUTE_MODE=direct
# Direct mode pays from its own wallet, never the deployer.
# Create: npx tsx agents/scripts/new-wallet.ts COMPUTE_WALLET · status/fund: npx tsx zerog/scripts/fund-testnet-compute.ts
COMPUTE_WALLET_PRIVATE_KEY=
COMPUTE_WALLET_ADDRESS=
# Optional: override provider (default 0xd6269e…C940 = qwen/qwen3.8-omni-flash, the only reachable testnet chatbot)
#ZEROG_PROVIDER_ADDRESS=
# Optional: override the provider's model id; 1 = reject responses whose TEE signature fails
#ZEROG_DIRECT_MODEL=
#ZEROG_DIRECT_REQUIRE_TEE=1
# Mainnet Router (decision D3). Testnet router-api-testnet.integratenetwork.work was unreachable 2026-11-06.
ZEROG_ROUTER_URL=https://router-api.0g.ai/v1
ZEROG_ROUTER_KEY=sk-...
# TEE-attested, text + image (live catalog: GET https://router-api.0g.ai/v1/models)
ZEROG_MODEL=0gm-1.0-35b-a3b
# Ask the Router to verify the provider TEE signature (verify_tee). 1 = on
ZEROG_VERIFY_TEE=1
# Optional mk- management key: lets smoke:compute print the account balance
ZEROG_MANAGEMENT_KEY=
# Galileo RPC (direct compute + storage). ZEROG_PRIVATE_KEY = storage uploads only.
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_PRIVATE_KEY=
ZEROG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
