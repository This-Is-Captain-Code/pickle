<mujoco model="pickle_stage">
  <!-- Unitree G1 (BSD-3, see LICENSE) welded to a stand, on the Pickle teleop stage:
       one table at natural reach, one box, one drop zone. The extra boxes, the
       obstacle rail and the person are required by the sim engine and parked
       far off-stage until a scenario needs them. -->
  <include file="g1_fixed.xml"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <default class="marker"><geom contype="0" conaffinity="0"/></default>
  </default>

  <worldbody>
    <light pos="1 1 3" dir="-0.3 -0.3 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="-2 -1 2.5" dir="0.5 0.3 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" rgba="0.93 0.94 0.95 1"/>

    <!-- stand holding the pelvis at 0.793 m -->
    <geom name="stand_post" type="cylinder" size="0.04 0.36" pos="-0.16 0 0.36" rgba="0.24 0.26 0.29 1"/>
    <geom name="stand_arm" type="box" size="0.05 0.03 0.02" pos="-0.13 0 0.74" rgba="0.24 0.26 0.29 1"/>
    <geom name="stand_base" type="cylinder" size="0.22 0.02" pos="-0.16 0 0.02" rgba="0.09 0.09 0.09 1"/>

    <!-- the work table: top at 0.81 m, meeting the hands' rest height
         (rest-pose wrist midpoint measured at x 0.27, y 0, z 0.87) -->
    <geom name="table" type="box" size="0.18 0.32 0.02" pos="0.36 0 0.79" rgba="0.88 0.86 0.82 1"/>
    <geom name="table_leg" type="box" size="0.05 0.05 0.37" pos="0.36 0 0.40" rgba="0.30 0.32 0.36 1"/>
    <geom name="table_foot" type="box" size="0.14 0.20 0.015" pos="0.36 0 0.015" rgba="0.24 0.26 0.29 1"/>

    <!-- the task, readable at a glance: box centered between the resting
         hands, green drop zone on the robot's right -->
    <geom name="drop_zone" class="marker" type="box" size="0.10 0.11 0.002" pos="0.38 -0.19 0.812" rgba="0 0.76 0.19 0.45"/>

    <body name="box0" pos="0.28 0 0.875"><freejoint name="box0_free"/><geom name="box0" type="box" size="0.06 0.09 0.06" mass="0.4" rgba="1 0.68 0 1"/></body>

    <!-- engine-required bodies, parked off-stage -->
    <body name="box1" pos="3 0 0.06"><freejoint name="box1_free"/><geom name="box1" type="box" size="0.06 0.09 0.06" mass="0.4" rgba="0.3 0.6 1 1"/></body>
    <body name="box2" pos="3.4 0 0.06"><freejoint name="box2_free"/><geom name="box2" type="box" size="0.06 0.09 0.06" mass="0.4" rgba="0.6 0.9 0.4 1"/></body>
    <body name="box3" pos="3.8 0 0.06"><freejoint name="box3_free"/><geom name="box3" type="box" size="0.06 0.09 0.06" mass="0.4" rgba="1 0.4 0.4 1"/></body>
    <body name="box4" pos="4.2 0 0.06"><freejoint name="box4_free"/><geom name="box4" type="box" size="0.06 0.09 0.06" mass="0.4" rgba="0.8 0.6 1 1"/></body>
    <body name="obstacle" pos="3 3 0.05">
      <freejoint name="obstacle_free"/>
      <geom name="obstacle" type="box" size="0.04 0.36 0.02" mass="2.5" rgba="0.62 0.35 0.15 1"/>
    </body>
    <body name="person" mocap="true" pos="3 -3 0.9">
      <geom name="person_body" type="capsule" size="0.16 0.5" rgba="0.53 0 1 1"/>
      <geom name="person_head" type="sphere" size="0.13" pos="0 0 0.75" rgba="0.95 0.75 0.65 1"/>
    </body>
  </worldbody>

</mujoco>
